# Copy this file to backend/.env.local and fill it in. backend/.env.local is git-ignored. NEVER commit it, NEVER paste it in chat.

# Project URL: Supabase dashboard -> Project Settings -> API. Looks like https://abcdefgh.supabase.co  (public, safe)
SUPABASE_URL=

# SECRET key (called "service_role" on older projects, "Secret key" on newer ones). It can do ANYTHING in your project.
# Only ever lives on your own computer.
SUPABASE_SECRET_KEY=
